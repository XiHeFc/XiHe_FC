{
  "id": "xihe.demo.hello",
  "name": "插件示例：链路体检",
  "version": "1.1.0",
  "publisher": "xihe",
  "description": "演示贡献点机制：一条命令、一个状态栏项、一项配置、一个插件视图。命令与视图都按需激活，不占启动时间。",
  "apiVersion": "1",
  "engines": { "xhgcs": ">=0.10.0 <1.0.0" },
  "main": "main.js",
  "activationEvents": ["onCommand:demo.linkReport", "onView:demo.health"],
  "permissions": ["data:read", "ui:statusBar", "ui:toast", "ui:view", "config:read", "commands:execute"],
  "contributes": {
    "commands": [
      { "id": "demo.linkReport", "title": "链路体检", "category": "示例" }
    ],
    "views": [
      { "id": "demo.health", "name": "链路健康", "icon": "◉", "order": 10 }
    ],
    "statusBar": [
      {
        "id": "demo.channels",
        "text": "链路 ✓",
        "alignment": "right",
        "priority": 40,
        "command": "demo.linkReport",
        "tooltip": "统计当前通道数量与活跃度"
      }
    ],
    "configuration": {
      "title": "链路体检",
      "properties": {
        "warnChannels": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 64,
          "description": "通道数告警阈值"
        },
        "sparkPoints": {
          "type": "number",
          "default": 90,
          "minimum": 20,
          "maximum": 600,
          "description": "每条曲线采样点数"
        }
      }
    }
  }
}
